// Hostel Booking — PostgreSQL schema.
// Conventions: UUIDv7 ids, money in integer paise, stay dates are date-only in the hostel timezone,
// snake_case tables/columns, soft delete via deletedAt on user-facing entities.
// Raw-SQL extras (CHECK constraints, audit trigger + hash chain, geo/trigram indexes) live in the
// migration `*_db_extras` and are documented in docs/erd.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  GUEST
  OWNER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  GOVERNMENT_ID
  PROPERTY_PROOF
  BUSINESS_LICENSE
  GST_CERTIFICATE
  OTHER
}

enum PropertyType {
  HOSTEL
  PG
}

enum HostelStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingMode {
  INSTANT
  APPROVAL
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum GenderPolicy {
  MIXED
  MALE_ONLY
  FEMALE_ONLY
}

enum RoomKind {
  DORM
  PRIVATE
}

enum RoomGender {
  MIXED
  MALE
  FEMALE
}

enum PriceUnit {
  NIGHT
  MONTH
}

enum PriceRuleType {
  WEEKEND
  DATE_RANGE
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum BookingStatus {
  HOLD
  PENDING_PAYMENT
  PENDING_APPROVAL
  CONFIRMED
  CHECKED_IN
  COMPLETED
  EXPIRED
  CANCELLED_BY_GUEST
  CANCELLED_BY_OWNER
  REJECTED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  PENDING
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum LedgerAccount {
  GUEST
  PLATFORM_ESCROW
  PLATFORM_REVENUE
  OWNER_PAYABLE
  TAX_PAYABLE
  REFUND_PAYABLE
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum DiscountType {
  PERCENT
  FLAT
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_APPROVAL_REQUESTED
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_EXPIRED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFUND_PROCESSED
  REVIEW_REQUESTED
  REVIEW_RECEIVED
  REVIEW_REPLIED
  HOSTEL_APPROVED
  HOSTEL_REJECTED
  KYC_APPROVED
  KYC_REJECTED
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique // always stored lower-cased
  passwordHash    String?    @map("password_hash") // null for Google-only accounts
  googleSub       String?    @unique @map("google_sub")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles               UserRoleAssignment[]
  profile             Profile?
  ownerProfile        OwnerProfile?
  refreshTokens       RefreshToken[]
  emailVerifyTokens   EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  devices             Device[]
  hostels             Hostel[]
  bookings            Booking[]
  reviews             Review[]
  wishlist            Wishlist[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference?
  couponRedemptions   CouponRedemption[]
  couponsCreated      Coupon[]
  refundsInitiated    Refund[]

  @@index([status])
  @@map("users")
}

model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model Profile {
  userId         String    @id @map("user_id") @db.Uuid
  fullName       String    @map("full_name")
  phone          String?
  avatarUrl      String?   @map("avatar_url")
  avatarPublicId String?   @map("avatar_public_id")
  gender         String? // MALE | FEMALE | OTHER | UNDISCLOSED
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  city           String?
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model OwnerProfile {
  userId             String        @id @map("user_id") @db.Uuid
  businessName       String?       @map("business_name")
  gstin              String?
  panLast4           String?       @map("pan_last4") // never store the full PAN
  payoutAccountRef   String?       @map("payout_account_ref") // opaque reference, no raw bank details in v1
  kycStatus          KycStatus     @default(NOT_SUBMITTED) @map("kyc_status")
  kycReviewedById    String?       @map("kyc_reviewed_by_id") @db.Uuid
  kycReviewedAt      DateTime?     @map("kyc_reviewed_at")
  kycRejectionReason String?       @map("kyc_rejection_reason")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          KycDocument[]

  @@map("owner_profiles")
}

model KycDocument {
  id           String          @id @default(uuid(7)) @db.Uuid
  ownerId      String          @map("owner_id") @db.Uuid
  type         KycDocumentType
  publicId     String          @map("public_id") // Cloudinary public_id (delivery type: authenticated)
  resourceType String          @default("image") @map("resource_type")
  format       String?
  bytes        Int?
  createdAt    DateTime        @default(now()) @map("created_at")
  deletedAt    DateTime?       @map("deleted_at")
  owner        OwnerProfile    @relation(fields: [ownerId], references: [userId], onDelete: Cascade)

  @@index([ownerId])
  @@map("kyc_documents")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid // all rotations of one login share a family
  tokenHash    String    @unique @map("token_hash") // sha256 of the opaque token
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Device {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  pushToken  String         @unique @map("push_token") // FCM-ready; push delivery itself is a later phase
  createdAt  DateTime       @default(now()) @map("created_at")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

// ───────────────────────── Listings ─────────────────────────

model Hostel {
  id                 String             @id @default(uuid(7)) @db.Uuid
  ownerId            String             @map("owner_id") @db.Uuid
  slug               String             @unique
  name               String
  description        String
  propertyType       PropertyType       @default(HOSTEL) @map("property_type")
  status             HostelStatus       @default(DRAFT)
  bookingMode        BookingMode        @default(INSTANT) @map("booking_mode")
  cancellationPolicy CancellationPolicy @default(MODERATE) @map("cancellation_policy")
  genderPolicy       GenderPolicy       @default(MIXED) @map("gender_policy")
  timezone           String             @default("Asia/Kolkata")
  currency           String             @default("INR")
  addressLine1       String             @map("address_line1")
  addressLine2       String?            @map("address_line2")
  locality           String?
  city               String
  state              String
  postalCode         String             @map("postal_code")
  country            String             @default("IN")
  latitude           Float
  longitude          Float
  phone              String?
  contactEmail       String?            @map("contact_email")
  checkInTime        String             @default("14:00") @map("check_in_time") // HH:mm in hostel timezone
  checkOutTime       String             @default("11:00") @map("check_out_time")
  houseRules         String?            @map("house_rules")
  gstin              String?
  // denormalised read models, maintained by services/jobs
  avgRating          Float              @default(0) @map("avg_rating")
  reviewCount        Int                @default(0) @map("review_count")
  minPricePaise      Int?               @map("min_price_paise")
  rejectionReason    String?            @map("rejection_reason")
  approvedAt         DateTime?          @map("approved_at")
  approvedById       String?            @map("approved_by_id") @db.Uuid
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  owner     User            @relation(fields: [ownerId], references: [id])
  amenities HostelAmenity[]
  media     Media[]
  roomTypes RoomType[]
  bookings  Booking[]
  reviews   Review[]
  wishlist  Wishlist[]
  coupons   Coupon[]
  payouts   Payout[]

  @@index([ownerId])
  @@index([status, city])
  @@index([status, propertyType])
  @@index([avgRating])
  @@map("hostels")
}

model Amenity {
  id       String          @id @default(uuid(7)) @db.Uuid
  code     String          @unique // WIFI, AC, LOCKERS, LAUNDRY, ...
  label    String
  category String // COMFORT | SAFETY | FOOD | WORK | WELLNESS | TRANSPORT
  icon     String?
  hostels  HostelAmenity[]

  @@map("amenities")
}

model HostelAmenity {
  hostelId  String  @map("hostel_id") @db.Uuid
  amenityId String  @map("amenity_id") @db.Uuid
  hostel    Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hostelId, amenityId])
  @@index([amenityId])
  @@map("hostel_amenities")
}

model Media {
  id         String    @id @default(uuid(7)) @db.Uuid
  hostelId   String    @map("hostel_id") @db.Uuid
  roomTypeId String?   @map("room_type_id") @db.Uuid
  kind       MediaKind @default(IMAGE)
  publicId   String    @unique @map("public_id") // Cloudinary public_id
  url        String
  width      Int?
  height     Int?
  bytes      Int?
  format     String?
  altText    String?   @map("alt_text")
  sortOrder  Int       @default(0) @map("sort_order")
  isCover    Boolean   @default(false) @map("is_cover")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")
  hostel     Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  @@index([hostelId, sortOrder])
  @@index([roomTypeId])
  @@map("media")
}

model RoomType {
  id                  String     @id @default(uuid(7)) @db.Uuid
  hostelId            String     @map("hostel_id") @db.Uuid
  name                String
  description         String?
  kind                RoomKind
  gender              RoomGender @default(MIXED)
  totalUnits          Int        @map("total_units") // beds for DORM, rooms for PRIVATE
  maxOccupancyPerUnit Int        @default(1) @map("max_occupancy_per_unit") // 1 for a bed; 1-4 for private rooms
  basePricePaise      Int        @map("base_price_paise") // per unit per priceUnit
  priceUnit           PriceUnit  @default(NIGHT) @map("price_unit")
  minStayNights       Int        @default(1) @map("min_stay_nights")
  maxStayNights       Int        @default(30) @map("max_stay_nights")
  isActive            Boolean    @default(true) @map("is_active")
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  hostel     Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  priceRules PriceRule[]
  blocked    BlockedDate[]
  inventory  InventoryNight[]
  items      BookingItem[]
  media      Media[]

  @@index([hostelId, isActive])
  @@map("room_types")
}

model PriceRule {
  id            String        @id @default(uuid(7)) @db.Uuid
  roomTypeId    String        @map("room_type_id") @db.Uuid
  type          PriceRuleType
  name          String?
  startDate     DateTime?     @map("start_date") @db.Date // DATE_RANGE only
  endDate       DateTime?     @map("end_date") @db.Date // inclusive
  weekdays      Int[] // WEEKEND: 0=Sun..6=Sat
  pricePaise    Int?          @map("price_paise") // absolute override per unit per night
  adjustmentBps Int?          @map("adjustment_bps") // or +/- percentage in basis points (e.g. 2000 = +20%)
  priority      Int           @default(0) // higher wins
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  roomType      RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, isActive])
  @@map("price_rules")
}

model BlockedDate {
  id           String   @id @default(uuid(7)) @db.Uuid
  roomTypeId   String   @map("room_type_id") @db.Uuid
  date         DateTime @db.Date
  unitsBlocked Int      @map("units_blocked") // how many units are taken out of sale that night
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")
  roomType     RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@map("blocked_dates")
}

/// Concurrency core: one row per room type per night. CHECK (held + booked + blocked <= total) is in db_extras.
model InventoryNight {
  roomTypeId   String   @map("room_type_id") @db.Uuid
  date         DateTime @db.Date
  totalUnits   Int      @map("total_units")
  heldUnits    Int      @default(0) @map("held_units")
  blockedUnits Int      @default(0) @map("blocked_units") // owner-blocked units (calendar)
  bookedUnits  Int      @default(0) @map("booked_units")
  updatedAt    DateTime @updatedAt @map("updated_at")
  roomType     RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, date])
  @@index([date])
  @@map("inventory_nights")
}

// ───────────────────────── Bookings ─────────────────────────

model Booking {
  id                 String             @id @default(uuid(7)) @db.Uuid
  code               String             @unique // human-friendly, e.g. HB-7K3M9Q
  guestId            String             @map("guest_id") @db.Uuid
  hostelId           String             @map("hostel_id") @db.Uuid
  status             BookingStatus      @default(HOLD)
  checkIn            DateTime           @map("check_in") @db.Date
  checkOut           DateTime           @map("check_out") @db.Date
  nights             Int
  guestsCount        Int                @map("guests_count")
  currency           String             @default("INR")
  subtotalPaise      Int                @map("subtotal_paise")
  taxPaise           Int                @map("tax_paise")
  gstRateBps         Int                @map("gst_rate_bps") // snapshot of the GST slab applied
  serviceFeePaise    Int                @default(0) @map("service_fee_paise")
  discountPaise      Int                @default(0) @map("discount_paise")
  totalPaise         Int                @map("total_paise")
  commissionBps      Int                @map("commission_bps") // snapshot of platform commission
  cancellationPolicy CancellationPolicy @map("cancellation_policy") // snapshot
  bookingMode        BookingMode        @map("booking_mode") // snapshot
  couponId           String?            @map("coupon_id") @db.Uuid
  contactPhone       String?            @map("contact_phone")
  specialRequests    String?            @map("special_requests")
  holdExpiresAt      DateTime?          @map("hold_expires_at")
  approvalDeadline   DateTime?          @map("approval_deadline")
  confirmedAt        DateTime?          @map("confirmed_at")
  checkedInAt        DateTime?          @map("checked_in_at")
  completedAt        DateTime?          @map("completed_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelledById      String?            @map("cancelled_by_id") @db.Uuid
  cancelReason       String?            @map("cancel_reason")
  idempotencyKey     String?            @map("idempotency_key")
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  guest      User                   @relation(fields: [guestId], references: [id])
  hostel     Hostel                 @relation(fields: [hostelId], references: [id])
  coupon     Coupon?                @relation(fields: [couponId], references: [id])
  items      BookingItem[]
  guests     BookingGuest[]
  history    BookingStatusHistory[]
  payments   Payment[]
  refunds    Refund[]
  review     Review?
  redemption CouponRedemption?
  ledger     LedgerEntry[]

  @@unique([guestId, idempotencyKey])
  @@index([guestId, status])
  @@index([hostelId, status, checkIn])
  @@index([status, holdExpiresAt])
  @@index([checkIn])
  @@map("bookings")
}

model BookingItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  bookingId        String   @map("booking_id") @db.Uuid
  roomTypeId       String   @map("room_type_id") @db.Uuid
  units            Int
  nightlyBreakdown Json     @map("nightly_breakdown") // [{date:'2026-12-01', unitPricePaise: 90000}, ...] price snapshot
  lineTotalPaise   Int      @map("line_total_paise")
  roomNameSnapshot String   @map("room_name_snapshot")
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType         RoomType @relation(fields: [roomTypeId], references: [id])

  @@index([bookingId])
  @@index([roomTypeId])
  @@map("booking_items")
}

model BookingGuest {
  id        String  @id @default(uuid(7)) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  fullName  String  @map("full_name")
  gender    String?
  age       Int?
  idType    String? @map("id_type") // AADHAAR | PASSPORT | DL | ...
  idLast4   String? @map("id_last4") // never store full ID numbers
  isPrimary Boolean @default(false) @map("is_primary")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_guests")
}

model BookingStatusHistory {
  id         String         @id @default(uuid(7)) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  actorRole  String?        @map("actor_role") // GUEST | OWNER | ADMIN | SYSTEM
  reason     String?
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// ───────────────────────── Payments (demo gateway, production-shaped) ─────────────────────────

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  provider          String // 'demo' now; 'razorpay' later
  providerOrderId   String        @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  amountPaise       Int           @map("amount_paise")
  refundedPaise     Int           @default(0) @map("refunded_paise")
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String? // UPI | CARD | NETBANKING | WALLET
  failureCode       String?       @map("failure_code")
  failureReason     String?       @map("failure_reason")
  capturedAt        DateTime?     @map("captured_at")
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  booking  Booking          @relation(fields: [bookingId], references: [id])
  attempts PaymentAttempt[]
  refunds  Refund[]
  ledger   LedgerEntry[]

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model PaymentAttempt {
  id           String               @id @default(uuid(7)) @db.Uuid
  paymentId    String               @map("payment_id") @db.Uuid
  status       PaymentAttemptStatus @default(INITIATED)
  instrument   String // e.g. DEMO_SUCCESS, DEMO_FAIL, DEMO_PENDING, DEMO_TIMEOUT
  method       String?
  errorCode    String?              @map("error_code")
  errorMessage String?              @map("error_message")
  raw          Json?
  createdAt    DateTime             @default(now()) @map("created_at")
  payment      Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_attempts")
}

model Refund {
  id               String        @id @default(uuid(7)) @db.Uuid
  paymentId        String        @map("payment_id") @db.Uuid
  bookingId        String        @map("booking_id") @db.Uuid
  amountPaise      Int           @map("amount_paise")
  status           RefundStatus  @default(PENDING)
  reason           String
  providerRefundId String?       @unique @map("provider_refund_id")
  initiatedById    String?       @map("initiated_by_id") @db.Uuid
  idempotencyKey   String        @unique @map("idempotency_key")
  processedAt      DateTime?     @map("processed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  payment          Payment       @relation(fields: [paymentId], references: [id])
  booking          Booking       @relation(fields: [bookingId], references: [id])
  initiatedBy      User?         @relation(fields: [initiatedById], references: [id])
  ledger           LedgerEntry[]

  @@index([paymentId])
  @@index([bookingId])
  @@map("refunds")
}

/// Append-only double-entry ledger. Every group of rows (groupId) must balance; enforced by the service
/// and verified by a test + job. UPDATE/DELETE are blocked by a trigger (db_extras).
model LedgerEntry {
  id            String        @id @default(uuid(7)) @db.Uuid
  groupId       String        @map("group_id") @db.Uuid
  bookingId     String?       @map("booking_id") @db.Uuid
  paymentId     String?       @map("payment_id") @db.Uuid
  refundId      String?       @map("refund_id") @db.Uuid
  debitAccount  LedgerAccount @map("debit_account")
  creditAccount LedgerAccount @map("credit_account")
  amountPaise   Int           @map("amount_paise")
  memo          String
  createdAt     DateTime      @default(now()) @map("created_at")
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  payment       Payment?      @relation(fields: [paymentId], references: [id])
  refund        Refund?       @relation(fields: [refundId], references: [id])

  @@index([groupId])
  @@index([bookingId])
  @@index([paymentId])
  @@map("ledger_entries")
}

model WebhookEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  provider       String
  eventId        String        @map("event_id") // provider's event id => idempotency
  type           String
  payload        Json
  signatureValid Boolean       @map("signature_valid")
  status         WebhookStatus @default(RECEIVED)
  error          String?
  receivedAt     DateTime      @default(now()) @map("received_at")
  processedAt    DateTime?     @map("processed_at")

  @@unique([provider, eventId])
  @@index([status])
  @@map("webhook_events")
}

model Payout {
  id          String       @id @default(uuid(7)) @db.Uuid
  hostelId    String       @map("hostel_id") @db.Uuid
  amountPaise Int          @map("amount_paise")
  periodStart DateTime     @map("period_start") @db.Date
  periodEnd   DateTime     @map("period_end") @db.Date
  status      PayoutStatus @default(PENDING)
  reference   String?
  paidAt      DateTime?    @map("paid_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  hostel      Hostel       @relation(fields: [hostelId], references: [id])

  @@index([hostelId, status])
  @@map("payouts")
}

// ───────────────────────── Engagement ─────────────────────────

model Review {
  id             String       @id @default(uuid(7)) @db.Uuid
  bookingId      String       @unique @map("booking_id") @db.Uuid // one review per completed booking
  hostelId       String       @map("hostel_id") @db.Uuid
  guestId        String       @map("guest_id") @db.Uuid
  overall        Int // 1..5 (CHECK in db_extras)
  cleanliness    Int?
  location       Int?
  staff          Int?
  valueForMoney  Int?         @map("value_for_money")
  title          String?
  comment        String?
  ownerReply     String?      @map("owner_reply")
  ownerRepliedAt DateTime?    @map("owner_replied_at")
  status         ReviewStatus @default(PUBLISHED)
  editedAt       DateTime?    @map("edited_at") // set when the guest changes a published review
  // moderation (admin hides a review that breaks the content rules; the reason is shown to the guest)
  moderationReason String?    @map("moderation_reason")
  moderatedById    String?    @map("moderated_by_id") @db.Uuid
  moderatedAt      DateTime?  @map("moderated_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  booking        Booking      @relation(fields: [bookingId], references: [id])
  hostel         Hostel       @relation(fields: [hostelId], references: [id])
  guest          User         @relation(fields: [guestId], references: [id])

  @@index([hostelId, status, createdAt])
  @@index([guestId])
  @@index([status, createdAt])
  @@map("reviews")
}

model Wishlist {
  userId    String   @map("user_id") @db.Uuid
  hostelId  String   @map("hostel_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostel    Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@id([userId, hostelId])
  @@index([hostelId])
  @@map("wishlists")
}

model Coupon {
  id               String             @id @default(uuid(7)) @db.Uuid
  code             String             @unique // stored upper-cased
  description      String?
  discountType     DiscountType       @map("discount_type")
  percentBps       Int?               @map("percent_bps") // PERCENT: 1000 = 10%
  flatPaise        Int?               @map("flat_paise") // FLAT
  maxDiscountPaise Int?               @map("max_discount_paise")
  minBookingPaise  Int                @default(0) @map("min_booking_paise")
  hostelId         String?            @map("hostel_id") @db.Uuid // null => platform-wide (admin only)
  createdById      String             @map("created_by_id") @db.Uuid
  validFrom        DateTime           @map("valid_from")
  validTo          DateTime           @map("valid_to")
  usageLimit       Int?               @map("usage_limit")
  usedCount        Int                @default(0) @map("used_count")
  perUserLimit     Int                @default(1) @map("per_user_limit")
  isActive         Boolean            @default(true) @map("is_active")
  isPublic         Boolean            @default(false) @map("is_public") // listed as an offer on the property page; private codes are shared out of band
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  hostel           Hostel?            @relation(fields: [hostelId], references: [id])
  createdBy        User               @relation(fields: [createdById], references: [id])
  bookings         Booking[]
  redemptions      CouponRedemption[]

  @@index([hostelId, isActive])
  @@map("coupons")
}

model CouponRedemption {
  id          String   @id @default(uuid(7)) @db.Uuid
  couponId    String   @map("coupon_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  bookingId   String   @unique @map("booking_id") @db.Uuid
  amountPaise Int      @map("amount_paise")
  createdAt   DateTime @default(now()) @map("created_at")
  coupon      Coupon   @relation(fields: [couponId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt, id]) // the notification feed: newest first, keyset by id
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  userId         String   @id @map("user_id") @db.Uuid
  emailBookings  Boolean  @default(true) @map("email_bookings")
  emailMarketing Boolean  @default(false) @map("email_marketing")
  inAppBookings  Boolean  @default(true) @map("in_app_bookings")
  inAppReviews   Boolean  @default(true) @map("in_app_reviews")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ───────────────────────── Audit & infra ─────────────────────────

/// Append-only, tamper-evident. `prevHash`/`hash` are computed by a BEFORE INSERT trigger (db_extras),
/// so the chain cannot be forged by application bugs. No FKs on purpose: history must outlive entities.
model AuditLog {
  id         BigInt       @id @default(autoincrement())
  actorId    String?      @map("actor_id") @db.Uuid
  actorRole  String?      @map("actor_role")
  action     String // e.g. auth.login, hostel.update, booking.transition, payment.captured
  entityType String       @map("entity_type")
  entityId   String?      @map("entity_id")
  before     Json?
  after      Json?
  outcome    AuditOutcome @default(SUCCESS)
  requestId  String?      @map("request_id")
  ip         String?
  userAgent  String?      @map("user_agent")
  metadata   Json?
  prevHash   String?      @map("prev_hash")
  hash       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId, id])
  @@index([actorId, id])
  @@index([action, id])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  key            String
  userId         String    @map("user_id") @db.Uuid
  method         String
  path           String
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedAt       DateTime  @default(now()) @map("locked_at")
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime  @map("expires_at")

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
