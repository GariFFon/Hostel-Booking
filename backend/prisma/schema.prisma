// Hostel Booking — PostgreSQL schema.
// Conventions: UUIDv7 ids, money in integer paise, stay dates are date-only in the hostel timezone,
// snake_case tables/columns, soft delete via deletedAt on user-facing entities.
// Raw-SQL extras (CHECK constraints, audit trigger + hash chain, geo/trigram indexes) live in the
// migration `*_db_extras` and are documented in docs/erd.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  GUEST
  OWNER
  ADMIN
  STAFF // maintenance / operations staff; scoped to hostels through StaffAssignment (phase 13)
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  GOVERNMENT_ID
  PROPERTY_PROOF
  BUSINESS_LICENSE
  GST_CERTIFICATE
  OTHER
}

// HOTEL = short-term nightly bookings. HOSTEL and PG = long-term tenancy with monthly rent (see stayModeOf in src/modules/hostels/property-mode.ts).
enum PropertyType {
  HOSTEL
  PG
  HOTEL
}

enum RoomUnitStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum TenancyApplicationStatus {
  REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum TenancyStatus {
  INVITED // owner added the tenant; waiting for them to accept
  PENDING_MOVE_IN // approved/accepted, bed reserved, not moved in yet
  ACTIVE
  NOTICE // notice period running (phase 14)
  ENDED
  CANCELLED
}

enum RentInvoiceStatus {
  DUE
  PARTIALLY_PAID
  PAID
  VOID
}

enum RentLineType {
  RENT
  ELECTRICITY
  MAINTENANCE
  LATE_FEE
  ADJUSTMENT
  CREDIT
}

enum StaffTrade {
  ELECTRICIAN
  PLUMBER
  CARPENTER
  CLEANER
  COOK
  SECURITY
  WARDEN
  NETWORK
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum ComplaintCategory {
  ELECTRICAL
  PLUMBING
  CARPENTRY
  CLEANING
  FOOD
  WIFI
  SECURITY
  BEHAVIOUR
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  REOPENED
  REJECTED
}

enum CommentRole {
  TENANT
  OWNER
  STAFF
  ADMIN
  SYSTEM
}

// How a payment was made. ONLINE goes through the gateway (phase 12); the rest are recorded by the owner.
enum RentPayMethod {
  CASH
  UPI
  BANK
  ONLINE
  DEPOSIT // rent settled out of the tenant's security deposit at move-out
}

enum DepositSettlementStatus {
  DRAFT // the owner is itemising: the tenant has not seen it
  PROPOSED // sent to the tenant, who has 7 days to accept or dispute
  DISPUTED
  AGREED // accepted (or auto-accepted after silence, or resolved by an admin): the refund is being paid out
  COMPLETED
}

enum DeductionType {
  UNPAID_RENT
  DAMAGE
  CLEANING
  UTILITIES
  OTHER
}

enum HostelStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingMode {
  INSTANT
  APPROVAL
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum GenderPolicy {
  MIXED
  MALE_ONLY
  FEMALE_ONLY
}

enum RoomKind {
  DORM
  PRIVATE
}

enum RoomGender {
  MIXED
  MALE
  FEMALE
}

enum PriceUnit {
  NIGHT
  MONTH
}

enum PriceRuleType {
  WEEKEND
  DATE_RANGE
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum BookingStatus {
  HOLD
  PENDING_PAYMENT
  PENDING_APPROVAL
  CONFIRMED
  CHECKED_IN
  COMPLETED
  EXPIRED
  CANCELLED_BY_GUEST
  CANCELLED_BY_OWNER
  REJECTED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  PENDING
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum LedgerAccount {
  GUEST
  PLATFORM_ESCROW
  DEPOSIT_HELD
  PLATFORM_REVENUE
  OWNER_PAYABLE
  TAX_PAYABLE
  REFUND_PAYABLE
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum DiscountType {
  PERCENT
  FLAT
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_APPROVAL_REQUESTED
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_EXPIRED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFUND_PROCESSED
  REVIEW_REQUESTED
  REVIEW_RECEIVED
  REVIEW_REPLIED
  HOSTEL_APPROVED
  HOSTEL_REJECTED
  KYC_APPROVED
  KYC_REJECTED
  TENANCY_REQUESTED
  TENANCY_APPROVED
  TENANCY_REJECTED
  TENANCY_INVITED
  TENANCY_STARTED
  TENANCY_NOTICE
  TENANCY_ENDED
  RENT_INVOICE_ISSUED
  RENT_DUE_SOON
  RENT_OVERDUE
  RENT_PAID
  DEPOSIT_SETTLED
  COMPLAINT_CREATED
  COMPLAINT_ASSIGNED
  COMPLAINT_UPDATED
  COMPLAINT_RESOLVED
  STAFF_INVITED
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique // always stored lower-cased
  passwordHash    String?    @map("password_hash") // null for Google-only accounts
  googleSub       String?    @unique @map("google_sub")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles               UserRoleAssignment[]
  profile             Profile?
  ownerProfile        OwnerProfile?
  refreshTokens       RefreshToken[]
  emailVerifyTokens   EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  devices             Device[]
  hostels             Hostel[]
  bookings            Booking[]
  reviews             Review[]
  tenancyApplications TenancyApplication[]
  tenancies           Tenancy[]
  rentInvoices        RentInvoice[]
  staffProfile        StaffProfile?
  complaintsRaised    Complaint[]              @relation("ComplaintRaisedBy")
  complaintsAssigned  Complaint[]              @relation("ComplaintAssignedTo")
  wishlist            Wishlist[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference?
  couponRedemptions   CouponRedemption[]
  couponsCreated      Coupon[]
  refundsInitiated    Refund[]

  @@index([status])
  @@map("users")
}

model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model Profile {
  userId         String    @id @map("user_id") @db.Uuid
  fullName       String    @map("full_name")
  phone          String?
  avatarUrl      String?   @map("avatar_url")
  avatarPublicId String?   @map("avatar_public_id")
  gender         String? // MALE | FEMALE | OTHER | UNDISCLOSED
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  city           String?
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model OwnerProfile {
  userId             String        @id @map("user_id") @db.Uuid
  businessName       String?       @map("business_name")
  gstin              String?
  panLast4           String?       @map("pan_last4") // never store the full PAN
  payoutAccountRef   String?       @map("payout_account_ref") // opaque reference, no raw bank details in v1
  kycStatus          KycStatus     @default(NOT_SUBMITTED) @map("kyc_status")
  kycReviewedById    String?       @map("kyc_reviewed_by_id") @db.Uuid
  kycReviewedAt      DateTime?     @map("kyc_reviewed_at")
  kycRejectionReason String?       @map("kyc_rejection_reason")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          KycDocument[]

  @@map("owner_profiles")
}

model KycDocument {
  id           String          @id @default(uuid(7)) @db.Uuid
  ownerId      String          @map("owner_id") @db.Uuid
  type         KycDocumentType
  publicId     String          @map("public_id") // Cloudinary public_id (delivery type: authenticated)
  resourceType String          @default("image") @map("resource_type")
  format       String?
  bytes        Int?
  createdAt    DateTime        @default(now()) @map("created_at")
  deletedAt    DateTime?       @map("deleted_at")
  owner        OwnerProfile    @relation(fields: [ownerId], references: [userId], onDelete: Cascade)

  @@index([ownerId])
  @@map("kyc_documents")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid // all rotations of one login share a family
  tokenHash    String    @unique @map("token_hash") // sha256 of the opaque token
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Device {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  pushToken  String         @unique @map("push_token") // FCM-ready; push delivery itself is a later phase
  createdAt  DateTime       @default(now()) @map("created_at")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

// ───────────────────────── Listings ─────────────────────────

model Hostel {
  id                 String             @id @default(uuid(7)) @db.Uuid
  ownerId            String             @map("owner_id") @db.Uuid
  slug               String             @unique
  name               String
  description        String
  propertyType       PropertyType       @default(HOSTEL) @map("property_type")
  status             HostelStatus       @default(DRAFT)
  bookingMode        BookingMode        @default(INSTANT) @map("booking_mode")
  cancellationPolicy CancellationPolicy @default(MODERATE) @map("cancellation_policy")
  genderPolicy       GenderPolicy       @default(MIXED) @map("gender_policy")
  timezone           String             @default("Asia/Kolkata")
  currency           String             @default("INR")
  addressLine1       String             @map("address_line1")
  addressLine2       String?            @map("address_line2")
  locality           String?
  city               String
  state              String
  postalCode         String             @map("postal_code")
  country            String             @default("IN")
  latitude           Float
  longitude          Float
  phone              String?
  contactEmail       String?            @map("contact_email")
  checkInTime        String             @default("14:00") @map("check_in_time") // HH:mm in hostel timezone
  checkOutTime       String             @default("11:00") @map("check_out_time")
  houseRules         String?            @map("house_rules")
  gstin              String?
  // long-term (HOSTEL/PG) terms; defaults are copied onto each tenancy
  depositMonths      Int                @default(2) @map("deposit_months")
  noticeDays         Int                @default(30) @map("notice_days")
  rentDueDay         Int                @default(1) @map("rent_due_day")
  rentGraceDays      Int                @default(5) @map("rent_grace_days")
  rentGstBps         Int                @default(0) @map("rent_gst_bps") // GST on rent; 0 by default (needs an accountant's sign-off)
  rentLateFeePaise   Int                @default(0) @map("rent_late_fee_paise") // flat fee added once when an invoice goes overdue
  // denormalised read models, maintained by services/jobs
  avgRating          Float              @default(0) @map("avg_rating")
  reviewCount        Int                @default(0) @map("review_count")
  minPricePaise      Int?               @map("min_price_paise")
  rejectionReason    String?            @map("rejection_reason")
  approvedAt         DateTime?          @map("approved_at")
  approvedById       String?            @map("approved_by_id") @db.Uuid
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  owner               User                 @relation(fields: [ownerId], references: [id])
  amenities           HostelAmenity[]
  media               Media[]
  roomTypes           RoomType[]
  bookings            Booking[]
  reviews             Review[]
  tenancyApplications TenancyApplication[]
  tenancies           Tenancy[]
  rentInvoices        RentInvoice[]
  complaints          Complaint[]
  staffAssignments    StaffAssignment[]
  wishlist            Wishlist[]
  coupons             Coupon[]
  payouts             Payout[]

  @@index([ownerId])
  @@index([status, city])
  @@index([status, propertyType])
  @@index([avgRating])
  @@map("hostels")
}

model Amenity {
  id       String          @id @default(uuid(7)) @db.Uuid
  code     String          @unique // WIFI, AC, LOCKERS, LAUNDRY, ...
  label    String
  category String // COMFORT | SAFETY | FOOD | WORK | WELLNESS | TRANSPORT
  icon     String?
  hostels  HostelAmenity[]

  @@map("amenities")
}

model HostelAmenity {
  hostelId  String  @map("hostel_id") @db.Uuid
  amenityId String  @map("amenity_id") @db.Uuid
  hostel    Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hostelId, amenityId])
  @@index([amenityId])
  @@map("hostel_amenities")
}

model Media {
  id         String    @id @default(uuid(7)) @db.Uuid
  hostelId   String    @map("hostel_id") @db.Uuid
  roomTypeId String?   @map("room_type_id") @db.Uuid
  kind       MediaKind @default(IMAGE)
  publicId   String    @unique @map("public_id") // Cloudinary public_id
  url        String
  width      Int?
  height     Int?
  bytes      Int?
  format     String?
  altText    String?   @map("alt_text")
  sortOrder  Int       @default(0) @map("sort_order")
  isCover    Boolean   @default(false) @map("is_cover")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")
  hostel     Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  @@index([hostelId, sortOrder])
  @@index([roomTypeId])
  @@map("media")
}

model RoomType {
  id                  String     @id @default(uuid(7)) @db.Uuid
  hostelId            String     @map("hostel_id") @db.Uuid
  name                String
  description         String?
  kind                RoomKind
  gender              RoomGender @default(MIXED)
  totalUnits          Int        @map("total_units") // beds for DORM, rooms for PRIVATE
  maxOccupancyPerUnit Int        @default(1) @map("max_occupancy_per_unit") // 1 for a bed; 1-4 for private rooms
  basePricePaise      Int        @map("base_price_paise") // per unit per priceUnit
  priceUnit           PriceUnit  @default(NIGHT) @map("price_unit")
  minStayNights       Int        @default(1) @map("min_stay_nights")
  maxStayNights       Int        @default(30) @map("max_stay_nights")
  isActive            Boolean    @default(true) @map("is_active")
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  hostel              Hostel               @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  priceRules          PriceRule[]
  blocked             BlockedDate[]
  inventory           InventoryNight[]
  items               BookingItem[]
  media               Media[]
  units               RoomUnit[]
  tenancyApplications TenancyApplication[]
  tenancies           Tenancy[]

  @@index([hostelId, isActive])
  @@map("room_types")
}

/// A physical bed (DORM) or room (PRIVATE) in a long-term property, e.g. label "204-B3". Nightly (HOTEL) properties keep using
/// the per-night counters on RoomType/InventoryNight; tenancies (phase 11) are assigned to a unit.
model RoomUnit {
  id         String         @id @default(uuid(7)) @db.Uuid
  roomTypeId String         @map("room_type_id") @db.Uuid
  label      String
  floor      Int?
  status     RoomUnitStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  roomType  RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  tenancies Tenancy[]

  @@index([roomTypeId, status])
  @@map("room_units")
}

model PriceRule {
  id            String        @id @default(uuid(7)) @db.Uuid
  roomTypeId    String        @map("room_type_id") @db.Uuid
  type          PriceRuleType
  name          String?
  startDate     DateTime?     @map("start_date") @db.Date // DATE_RANGE only
  endDate       DateTime?     @map("end_date") @db.Date // inclusive
  weekdays      Int[] // WEEKEND: 0=Sun..6=Sat
  pricePaise    Int?          @map("price_paise") // absolute override per unit per night
  adjustmentBps Int?          @map("adjustment_bps") // or +/- percentage in basis points (e.g. 2000 = +20%)
  priority      Int           @default(0) // higher wins
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  roomType      RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, isActive])
  @@map("price_rules")
}

model BlockedDate {
  id           String   @id @default(uuid(7)) @db.Uuid
  roomTypeId   String   @map("room_type_id") @db.Uuid
  date         DateTime @db.Date
  unitsBlocked Int      @map("units_blocked") // how many units are taken out of sale that night
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")
  roomType     RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@map("blocked_dates")
}

/// Concurrency core: one row per room type per night. CHECK (held + booked + blocked <= total) is in db_extras.
model InventoryNight {
  roomTypeId   String   @map("room_type_id") @db.Uuid
  date         DateTime @db.Date
  totalUnits   Int      @map("total_units")
  heldUnits    Int      @default(0) @map("held_units")
  blockedUnits Int      @default(0) @map("blocked_units") // owner-blocked units (calendar)
  bookedUnits  Int      @default(0) @map("booked_units")
  updatedAt    DateTime @updatedAt @map("updated_at")
  roomType     RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, date])
  @@index([date])
  @@map("inventory_nights")
}

// ───────────────────────── Bookings ─────────────────────────

model Booking {
  id                 String             @id @default(uuid(7)) @db.Uuid
  code               String             @unique // human-friendly, e.g. HB-7K3M9Q
  guestId            String             @map("guest_id") @db.Uuid
  hostelId           String             @map("hostel_id") @db.Uuid
  status             BookingStatus      @default(HOLD)
  checkIn            DateTime           @map("check_in") @db.Date
  checkOut           DateTime           @map("check_out") @db.Date
  nights             Int
  guestsCount        Int                @map("guests_count")
  currency           String             @default("INR")
  subtotalPaise      Int                @map("subtotal_paise")
  taxPaise           Int                @map("tax_paise")
  gstRateBps         Int                @map("gst_rate_bps") // snapshot of the GST slab applied
  serviceFeePaise    Int                @default(0) @map("service_fee_paise")
  discountPaise      Int                @default(0) @map("discount_paise")
  totalPaise         Int                @map("total_paise")
  commissionBps      Int                @map("commission_bps") // snapshot of platform commission
  cancellationPolicy CancellationPolicy @map("cancellation_policy") // snapshot
  bookingMode        BookingMode        @map("booking_mode") // snapshot
  couponId           String?            @map("coupon_id") @db.Uuid
  contactPhone       String?            @map("contact_phone")
  specialRequests    String?            @map("special_requests")
  holdExpiresAt      DateTime?          @map("hold_expires_at")
  approvalDeadline   DateTime?          @map("approval_deadline")
  confirmedAt        DateTime?          @map("confirmed_at")
  checkedInAt        DateTime?          @map("checked_in_at")
  completedAt        DateTime?          @map("completed_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelledById      String?            @map("cancelled_by_id") @db.Uuid
  cancelReason       String?            @map("cancel_reason")
  idempotencyKey     String?            @map("idempotency_key")
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  guest      User                   @relation(fields: [guestId], references: [id])
  hostel     Hostel                 @relation(fields: [hostelId], references: [id])
  coupon     Coupon?                @relation(fields: [couponId], references: [id])
  items      BookingItem[]
  guests     BookingGuest[]
  history    BookingStatusHistory[]
  payments   Payment[]
  refunds    Refund[]
  review     Review?
  redemption CouponRedemption?
  ledger     LedgerEntry[]

  @@unique([guestId, idempotencyKey])
  @@index([guestId, status])
  @@index([hostelId, status, checkIn])
  @@index([status, holdExpiresAt])
  @@index([checkIn])
  @@map("bookings")
}

model BookingItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  bookingId        String   @map("booking_id") @db.Uuid
  roomTypeId       String   @map("room_type_id") @db.Uuid
  units            Int
  nightlyBreakdown Json     @map("nightly_breakdown") // [{date:'2026-12-01', unitPricePaise: 90000}, ...] price snapshot
  lineTotalPaise   Int      @map("line_total_paise")
  roomNameSnapshot String   @map("room_name_snapshot")
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType         RoomType @relation(fields: [roomTypeId], references: [id])

  @@index([bookingId])
  @@index([roomTypeId])
  @@map("booking_items")
}

model BookingGuest {
  id        String  @id @default(uuid(7)) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  fullName  String  @map("full_name")
  gender    String?
  age       Int?
  idType    String? @map("id_type") // AADHAAR | PASSPORT | DL | ...
  idLast4   String? @map("id_last4") // never store full ID numbers
  isPrimary Boolean @default(false) @map("is_primary")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_guests")
}

model BookingStatusHistory {
  id         String         @id @default(uuid(7)) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  actorRole  String?        @map("actor_role") // GUEST | OWNER | ADMIN | SYSTEM
  reason     String?
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// ───────────────────────── Payments (demo gateway, production-shaped) ─────────────────────────

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  provider          String // 'demo' now; 'razorpay' later
  providerOrderId   String        @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  amountPaise       Int           @map("amount_paise")
  refundedPaise     Int           @default(0) @map("refunded_paise")
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String? // UPI | CARD | NETBANKING | WALLET
  failureCode       String?       @map("failure_code")
  failureReason     String?       @map("failure_reason")
  capturedAt        DateTime?     @map("captured_at")
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  booking  Booking          @relation(fields: [bookingId], references: [id])
  attempts PaymentAttempt[]
  refunds  Refund[]
  ledger   LedgerEntry[]

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model PaymentAttempt {
  id           String               @id @default(uuid(7)) @db.Uuid
  paymentId    String               @map("payment_id") @db.Uuid
  status       PaymentAttemptStatus @default(INITIATED)
  instrument   String // e.g. DEMO_SUCCESS, DEMO_FAIL, DEMO_PENDING, DEMO_TIMEOUT
  method       String?
  errorCode    String?              @map("error_code")
  errorMessage String?              @map("error_message")
  raw          Json?
  createdAt    DateTime             @default(now()) @map("created_at")
  payment      Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_attempts")
}

model Refund {
  id               String        @id @default(uuid(7)) @db.Uuid
  paymentId        String        @map("payment_id") @db.Uuid
  bookingId        String        @map("booking_id") @db.Uuid
  amountPaise      Int           @map("amount_paise")
  status           RefundStatus  @default(PENDING)
  reason           String
  providerRefundId String?       @unique @map("provider_refund_id")
  initiatedById    String?       @map("initiated_by_id") @db.Uuid
  idempotencyKey   String        @unique @map("idempotency_key")
  processedAt      DateTime?     @map("processed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  payment          Payment       @relation(fields: [paymentId], references: [id])
  booking          Booking       @relation(fields: [bookingId], references: [id])
  initiatedBy      User?         @relation(fields: [initiatedById], references: [id])
  ledger           LedgerEntry[]

  @@index([paymentId])
  @@index([bookingId])
  @@map("refunds")
}

/// Append-only double-entry ledger. Every group of rows (groupId) must balance; enforced by the service
/// and verified by a test + job. UPDATE/DELETE are blocked by a trigger (db_extras).
model LedgerEntry {
  id            String        @id @default(uuid(7)) @db.Uuid
  groupId       String        @map("group_id") @db.Uuid
  bookingId     String?       @map("booking_id") @db.Uuid
  paymentId     String?       @map("payment_id") @db.Uuid
  refundId      String?       @map("refund_id") @db.Uuid
  rentInvoiceId String?       @map("rent_invoice_id") @db.Uuid
  rentRefundId  String?       @map("rent_refund_id") @db.Uuid
  tenancyId     String?       @map("tenancy_id") @db.Uuid // deposit movements
  debitAccount  LedgerAccount @map("debit_account")
  creditAccount LedgerAccount @map("credit_account")
  amountPaise   Int           @map("amount_paise")
  memo          String
  createdAt     DateTime      @default(now()) @map("created_at")
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  payment       Payment?      @relation(fields: [paymentId], references: [id])
  refund        Refund?       @relation(fields: [refundId], references: [id])
  rentInvoice   RentInvoice?  @relation(fields: [rentInvoiceId], references: [id])
  rentRefund    RentRefund?   @relation(fields: [rentRefundId], references: [id])
  tenancy       Tenancy?      @relation(fields: [tenancyId], references: [id])

  @@index([rentInvoiceId])
  @@index([rentRefundId])
  @@index([tenancyId])
  @@index([groupId])
  @@index([bookingId])
  @@index([paymentId])
  @@map("ledger_entries")
}

model WebhookEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  provider       String
  eventId        String        @map("event_id") // provider's event id => idempotency
  type           String
  payload        Json
  signatureValid Boolean       @map("signature_valid")
  status         WebhookStatus @default(RECEIVED)
  error          String?
  receivedAt     DateTime      @default(now()) @map("received_at")
  processedAt    DateTime?     @map("processed_at")

  @@unique([provider, eventId])
  @@index([status])
  @@map("webhook_events")
}

model Payout {
  id          String       @id @default(uuid(7)) @db.Uuid
  hostelId    String       @map("hostel_id") @db.Uuid
  amountPaise Int          @map("amount_paise")
  periodStart DateTime     @map("period_start") @db.Date
  periodEnd   DateTime     @map("period_end") @db.Date
  status      PayoutStatus @default(PENDING)
  reference   String?
  paidAt      DateTime?    @map("paid_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  hostel      Hostel       @relation(fields: [hostelId], references: [id])

  @@index([hostelId, status])
  @@map("payouts")
}

// ───────────────────────── Engagement ─────────────────────────

model Review {
  id               String       @id @default(uuid(7)) @db.Uuid
  bookingId        String       @unique @map("booking_id") @db.Uuid // one review per completed booking
  hostelId         String       @map("hostel_id") @db.Uuid
  guestId          String       @map("guest_id") @db.Uuid
  overall          Int // 1..5 (CHECK in db_extras)
  cleanliness      Int?
  location         Int?
  staff            Int?
  valueForMoney    Int?         @map("value_for_money")
  title            String?
  comment          String?
  ownerReply       String?      @map("owner_reply")
  ownerRepliedAt   DateTime?    @map("owner_replied_at")
  status           ReviewStatus @default(PUBLISHED)
  editedAt         DateTime?    @map("edited_at") // set when the guest changes a published review
  // moderation (admin hides a review that breaks the content rules; the reason is shown to the guest)
  moderationReason String?      @map("moderation_reason")
  moderatedById    String?      @map("moderated_by_id") @db.Uuid
  moderatedAt      DateTime?    @map("moderated_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  booking          Booking      @relation(fields: [bookingId], references: [id])
  hostel           Hostel       @relation(fields: [hostelId], references: [id])
  guest            User         @relation(fields: [guestId], references: [id])

  @@index([hostelId, status, createdAt])
  @@index([guestId])
  @@index([status, createdAt])
  @@map("reviews")
}

model Wishlist {
  userId    String   @map("user_id") @db.Uuid
  hostelId  String   @map("hostel_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostel    Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@id([userId, hostelId])
  @@index([hostelId])
  @@map("wishlists")
}

model Coupon {
  id               String             @id @default(uuid(7)) @db.Uuid
  code             String             @unique // stored upper-cased
  description      String?
  discountType     DiscountType       @map("discount_type")
  percentBps       Int?               @map("percent_bps") // PERCENT: 1000 = 10%
  flatPaise        Int?               @map("flat_paise") // FLAT
  maxDiscountPaise Int?               @map("max_discount_paise")
  minBookingPaise  Int                @default(0) @map("min_booking_paise")
  hostelId         String?            @map("hostel_id") @db.Uuid // null => platform-wide (admin only)
  createdById      String             @map("created_by_id") @db.Uuid
  validFrom        DateTime           @map("valid_from")
  validTo          DateTime           @map("valid_to")
  usageLimit       Int?               @map("usage_limit")
  usedCount        Int                @default(0) @map("used_count")
  perUserLimit     Int                @default(1) @map("per_user_limit")
  isActive         Boolean            @default(true) @map("is_active")
  isPublic         Boolean            @default(false) @map("is_public") // listed as an offer on the property page; private codes are shared out of band
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  hostel           Hostel?            @relation(fields: [hostelId], references: [id])
  createdBy        User               @relation(fields: [createdById], references: [id])
  bookings         Booking[]
  redemptions      CouponRedemption[]

  @@index([hostelId, isActive])
  @@map("coupons")
}

model CouponRedemption {
  id          String   @id @default(uuid(7)) @db.Uuid
  couponId    String   @map("coupon_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  bookingId   String   @unique @map("booking_id") @db.Uuid
  amountPaise Int      @map("amount_paise")
  createdAt   DateTime @default(now()) @map("created_at")
  coupon      Coupon   @relation(fields: [couponId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  /// Set when a worker has taken this notification for push delivery (at most once). Partial index `notifications_unpushed_idx` is hand-written.
  pushedAt  DateTime?        @map("pushed_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt, id]) // the notification feed: newest first, keyset by id
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  userId          String   @id @map("user_id") @db.Uuid
  emailBookings   Boolean  @default(true) @map("email_bookings")
  emailMarketing  Boolean  @default(false) @map("email_marketing")
  inAppBookings   Boolean  @default(true) @map("in_app_bookings")
  inAppReviews    Boolean  @default(true) @map("in_app_reviews")
  inAppRent       Boolean  @default(true) @map("in_app_rent")
  emailRent       Boolean  @default(true) @map("email_rent")
  inAppComplaints Boolean  @default(true) @map("in_app_complaints")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ───────────────────────── Long-term tenancies (phase 11) ─────────────────────────

/// A student asks for a bed in a HOSTEL/PG. The owner approves (creating a Tenancy) or rejects.
/// At most one REQUESTED application per applicant and hostel (partial unique index in the migration).
model TenancyApplication {
  id                    String                   @id @default(uuid(7)) @db.Uuid
  hostelId              String                   @map("hostel_id") @db.Uuid
  roomTypeId            String                   @map("room_type_id") @db.Uuid
  applicantId           String                   @map("applicant_id") @db.Uuid
  status                TenancyApplicationStatus @default(REQUESTED)
  moveInDate            DateTime                 @map("move_in_date") @db.Date
  tenureMonths          Int?                     @map("tenure_months")
  gender                String? // MALE | FEMALE | OTHER, used for gender-restricted properties
  occupation            String?
  message               String?
  emergencyContactName  String                   @map("emergency_contact_name")
  emergencyContactPhone String                   @map("emergency_contact_phone")
  decisionNote          String?                  @map("decision_note")
  decidedAt             DateTime?                @map("decided_at")
  decidedById           String?                  @map("decided_by_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  hostel    Hostel   @relation(fields: [hostelId], references: [id])
  roomType  RoomType @relation(fields: [roomTypeId], references: [id])
  applicant User     @relation(fields: [applicantId], references: [id])
  tenancy   Tenancy?

  @@index([hostelId, status, createdAt])
  @@index([applicantId, createdAt])
  @@map("tenancy_applications")
}

/// A tenant's right to one unit (bed/room). Money terms are snapshotted so later edits to the property never change them.
model Tenancy {
  id                    String         @id @default(uuid(7)) @db.Uuid
  code                  String         @unique // TN-XXXXXX
  hostelId              String         @map("hostel_id") @db.Uuid
  roomTypeId            String         @map("room_type_id") @db.Uuid
  unitId                String         @map("unit_id") @db.Uuid
  tenantId              String?        @map("tenant_id") @db.Uuid // null while an invite for an unregistered email is pending
  applicationId         String?        @unique @map("application_id") @db.Uuid
  status                TenancyStatus
  startDate             DateTime       @map("start_date") @db.Date
  endDate               DateTime?      @map("end_date") @db.Date
  rentPaise             Int            @map("rent_paise")
  depositPaise          Int            @map("deposit_paise")
  dueDay                Int            @map("due_day")
  graceDays             Int            @map("grace_days")
  noticeDays            Int            @map("notice_days")
  gstRateBps            Int            @default(0) @map("gst_rate_bps")
  lateFeePaise          Int            @default(0) @map("late_fee_paise")
  depositReceivedAt     DateTime?      @map("deposit_received_at")
  depositMethod         RentPayMethod? @map("deposit_method")
  depositReference      String?        @map("deposit_reference")
  emergencyContactName  String?        @map("emergency_contact_name")
  emergencyContactPhone String?        @map("emergency_contact_phone")
  inviteEmail           String?        @map("invite_email")
  inviteTokenHash       String?        @unique @map("invite_token_hash")
  inviteExpiresAt       DateTime?      @map("invite_expires_at")
  activatedAt           DateTime?      @map("activated_at")
  cancelledAt           DateTime?      @map("cancelled_at")
  cancelReason          String?        @map("cancel_reason")
  noticeGivenAt         DateTime?      @map("notice_given_at")
  noticeBy              String?        @map("notice_by") // TENANT | OWNER
  noticeReason          String?        @map("notice_reason")
  movedOutAt            DateTime?      @map("moved_out_at")
  createdById           String         @map("created_by_id") @db.Uuid
  version               Int            @default(1)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  hostel      Hostel              @relation(fields: [hostelId], references: [id])
  roomType    RoomType            @relation(fields: [roomTypeId], references: [id])
  unit        RoomUnit            @relation(fields: [unitId], references: [id])
  tenant      User?               @relation(fields: [tenantId], references: [id])
  application TenancyApplication? @relation(fields: [applicationId], references: [id])
  invoices    RentInvoice[]
  complaints  Complaint[]
  orders      RentOrder[]
  settlement  DepositSettlement?
  ledger      LedgerEntry[]

  @@index([hostelId, status])
  @@index([tenantId, status])
  @@map("tenancies")
}

// ───────────────────────── Rent (phase 12) ─────────────────────────

/// One bill for one rent period of a tenancy. Amounts are the sum of its lines; tax applies to RENT lines only.
/// Overdue is derived (due date + grace has passed with a balance), not stored.
model RentInvoice {
  id                String            @id @default(uuid(7)) @db.Uuid
  number            String            @unique // INV-YYMM-XXXXXX
  tenancyId         String            @map("tenancy_id") @db.Uuid
  hostelId          String            @map("hostel_id") @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  periodStart       DateTime          @map("period_start") @db.Date
  periodEnd         DateTime          @map("period_end") @db.Date
  dueDate           DateTime          @map("due_date") @db.Date
  overdueAfter      DateTime          @map("overdue_after") @db.Date // due date + grace days: it counts as overdue after this day
  status            RentInvoiceStatus @default(DUE)
  subtotalPaise     Int               @map("subtotal_paise")
  taxPaise          Int               @default(0) @map("tax_paise")
  totalPaise        Int               @map("total_paise")
  paidPaise         Int               @default(0) @map("paid_paise")
  gstRateBps        Int               @default(0) @map("gst_rate_bps")
  issuedAt          DateTime          @default(now()) @map("issued_at")
  paidAt            DateTime?         @map("paid_at")
  voidedAt          DateTime?         @map("voided_at")
  voidReason        String?           @map("void_reason")
  lateFeeAppliedAt  DateTime?         @map("late_fee_applied_at")
  dueSoonNotifiedAt DateTime?         @map("due_soon_notified_at")
  overdueNotifiedAt DateTime?         @map("overdue_notified_at")
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tenancy  Tenancy           @relation(fields: [tenancyId], references: [id])
  hostel   Hostel            @relation(fields: [hostelId], references: [id])
  tenant   User              @relation(fields: [tenantId], references: [id])
  lines    RentInvoiceLine[]
  payments RentPayment[]
  orders   RentOrder[]
  ledger   LedgerEntry[]

  @@unique([tenancyId, periodStart])
  @@index([hostelId, status, dueDate])
  @@index([hostelId, status, overdueAfter])
  @@index([tenantId, status])
  @@map("rent_invoices")
}

model RentInvoiceLine {
  id          String       @id @default(uuid(7)) @db.Uuid
  invoiceId   String       @map("invoice_id") @db.Uuid
  type        RentLineType
  description String
  amountPaise Int          @map("amount_paise") // negative only for CREDIT
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  invoice RentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("rent_invoice_lines")
}

/// Money received against an invoice, online or recorded by the owner. Immutable except for an owner reversing a mistaken offline entry.
model RentPayment {
  id            String        @id @default(uuid(7)) @db.Uuid
  receiptNo     String        @unique @map("receipt_no") // RCPT-YYMM-XXXXXX
  invoiceId     String        @map("invoice_id") @db.Uuid
  tenancyId     String        @map("tenancy_id") @db.Uuid
  hostelId      String        @map("hostel_id") @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  amountPaise   Int           @map("amount_paise")
  method        RentPayMethod
  reference     String?
  note          String?
  receivedOn    DateTime      @map("received_on") @db.Date
  rentOrderId   String?       @unique @map("rent_order_id") @db.Uuid
  recordedById  String?       @map("recorded_by_id") @db.Uuid
  reversedAt    DateTime?     @map("reversed_at")
  reversedById  String?       @map("reversed_by_id") @db.Uuid
  reverseReason String?       @map("reverse_reason")
  /// Money already returned to the tenant (online payments only). Never more than `amountPaise`.
  refundedPaise Int           @default(0) @map("refunded_paise")
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice RentInvoice  @relation(fields: [invoiceId], references: [id])
  order   RentOrder?   @relation(fields: [rentOrderId], references: [id])
  refunds RentRefund[]

  @@index([invoiceId])
  @@index([hostelId, createdAt])
  @@map("rent_payments")
}

/// Money returned to a tenant for an online rent payment (by the owner or support). PENDING until the gateway confirms; mirrors Refund.
model RentRefund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  invoiceId        String       @map("invoice_id") @db.Uuid
  hostelId         String       @map("hostel_id") @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  amountPaise      Int          @map("amount_paise")
  reason           String
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @map("provider_refund_id")
  idempotencyKey   String       @unique @map("idempotency_key")
  initiatedById    String       @map("initiated_by_id") @db.Uuid
  initiatedByRole  String       @map("initiated_by_role") // OWNER | ADMIN
  processedAt      DateTime?    @map("processed_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  payment RentPayment   @relation(fields: [paymentId], references: [id])
  ledger  LedgerEntry[]

  @@index([paymentId, status])
  @@index([status, createdAt])
  @@index([hostelId, createdAt])
  @@map("rent_refunds")
}

/// An online (gateway) attempt to pay an invoice's balance. Mirrors Payment, kept separate so bookings are never affected.
model RentOrder {
  id                String        @id @default(uuid(7)) @db.Uuid
  /// Exactly one of invoiceId (paying rent) or tenancyId (paying the security deposit) is set.
  invoiceId         String?       @map("invoice_id") @db.Uuid
  tenancyId         String?       @map("tenancy_id") @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  provider          String
  providerOrderId   String        @unique @map("provider_order_id")
  providerPaymentId String?       @map("provider_payment_id")
  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String?
  failureCode       String?       @map("failure_code")
  failureReason     String?       @map("failure_reason")
  capturedAt        DateTime?     @map("captured_at")
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  invoice  RentInvoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  tenancy  Tenancy?           @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  attempts RentOrderAttempt[]
  payment  RentPayment?

  @@index([invoiceId, status])
  @@index([tenancyId, status])
  @@map("rent_orders")
}

model RentOrderAttempt {
  id           String               @id @default(uuid(7)) @db.Uuid
  orderId      String               @map("order_id") @db.Uuid
  status       PaymentAttemptStatus @default(INITIATED)
  instrument   String
  method       String?
  errorCode    String?              @map("error_code")
  errorMessage String?              @map("error_message")
  createdAt    DateTime             @default(now()) @map("created_at")

  order RentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@map("rent_order_attempts")
}

// ───────────────────────── Move-out and the security deposit (phase 14) ─────────────────────────

/// What happens to the security deposit when a stay ends. One per tenancy that held a deposit. The owner itemises deductions
/// (unpaid rent is pre-filled), the tenant accepts or disputes, and the rest is paid back: through the gateway when the deposit was
/// paid online, or recorded by the owner when it was paid in cash/UPI/bank.
model DepositSettlement {
  id                   String                  @id @default(uuid(7)) @db.Uuid
  tenancyId            String                  @unique @map("tenancy_id") @db.Uuid
  hostelId             String                  @map("hostel_id") @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  status               DepositSettlementStatus @default(DRAFT)
  depositPaise         Int                     @map("deposit_paise") // what was held
  deductionsPaise      Int                     @default(0) @map("deductions_paise")
  refundPaise          Int                     @map("refund_paise") // deposit - deductions
  note                 String?
  proposedAt           DateTime?               @map("proposed_at")
  respondedAt          DateTime?               @map("responded_at")
  disputeNote          String?                 @map("dispute_note")
  agreedAt             DateTime?               @map("agreed_at")
  autoAgreed           Boolean                 @default(false) @map("auto_agreed")
  resolvedByAdminId    String?                 @map("resolved_by_admin_id") @db.Uuid
  completedAt          DateTime?               @map("completed_at")
  payoutMethod         RentPayMethod?          @map("payout_method")
  payoutReference      String?                 @map("payout_reference")
  refundIdempotencyKey String?                 @unique @map("refund_idempotency_key")
  providerRefundId     String?                 @map("provider_refund_id")
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  tenancy    Tenancy            @relation(fields: [tenancyId], references: [id])
  deductions DepositDeduction[]
  proofs     DepositProof[]

  @@index([hostelId, status])
  @@index([tenantId, status])
  @@index([status, proposedAt])
  @@map("deposit_settlements")
}

model DepositDeduction {
  id           String            @id @default(uuid(7)) @db.Uuid
  settlementId String            @map("settlement_id") @db.Uuid
  type         DeductionType
  description  String
  amountPaise  Int               @map("amount_paise")
  invoiceId    String?           @map("invoice_id") @db.Uuid // for UNPAID_RENT: the invoice it settles
  createdAt    DateTime          @default(now()) @map("created_at")

  settlement DepositSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("deposit_deductions")
}

/// A photo the owner attaches as evidence for a deduction (damage, cleaning...).
model DepositProof {
  id           String   @id @default(uuid(7)) @db.Uuid
  settlementId String   @map("settlement_id") @db.Uuid
  publicId     String   @unique @map("public_id")
  url          String
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  settlement DepositSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("deposit_proofs")
}

// ───────────────────────── Staff and complaints (phase 13) ─────────────────────────

/// Someone who fixes things: an electrician, a plumber, a warden... `ownerId` set = the owner's own staff; null = a platform vendor
/// that owners can engage. Access to a property comes from StaffAssignment, never from the role alone.
model StaffProfile {
  userId    String      @id @map("user_id") @db.Uuid
  trade     StaffTrade
  ownerId   String?     @map("owner_id") @db.Uuid
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments StaffAssignment[]

  @@index([ownerId, status])
  @@index([trade, status])
  @@map("staff_profiles")
}

/// A staff member may work at a property. Removing or deactivating hands their open complaints back to the owner.
model StaffAssignment {
  id           String   @id @default(uuid(7)) @db.Uuid
  staffUserId  String   @map("staff_user_id") @db.Uuid
  hostelId     String   @map("hostel_id") @db.Uuid
  assignedById String   @map("assigned_by_id") @db.Uuid
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  staff  StaffProfile @relation(fields: [staffUserId], references: [userId], onDelete: Cascade)
  hostel Hostel       @relation(fields: [hostelId], references: [id])

  @@unique([staffUserId, hostelId])
  @@index([hostelId, active])
  @@map("staff_assignments")
}

/// An emailed invitation to become staff. Only the hash of the token is stored.
model StaffInvite {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String
  tokenHash    String     @unique @map("token_hash")
  trade        StaffTrade
  ownerId      String?    @map("owner_id") @db.Uuid // null = a platform vendor invited by an admin
  hostelIds    String[]   @map("hostel_ids") @db.Uuid
  invitedById  String     @map("invited_by_id") @db.Uuid
  expiresAt    DateTime   @map("expires_at")
  acceptedAt   DateTime?  @map("accepted_at")
  acceptedById String?    @map("accepted_by_id") @db.Uuid
  cancelledAt  DateTime?  @map("cancelled_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([ownerId, acceptedAt])
  @@index([email])
  @@map("staff_invites")
}

/// A tenant's report that something is wrong. Flows OPEN -> (ASSIGNED) -> IN_PROGRESS -> RESOLVED -> CLOSED, with an SLA by priority.
model Complaint {
  id                  String            @id @default(uuid(7)) @db.Uuid
  code                String            @unique // CMP-XXXXXX
  hostelId            String            @map("hostel_id") @db.Uuid
  tenancyId           String            @map("tenancy_id") @db.Uuid
  unitId              String?           @map("unit_id") @db.Uuid
  raisedById          String            @map("raised_by_id") @db.Uuid
  category            ComplaintCategory
  priority            ComplaintPriority @default(MEDIUM)
  title               String
  description         String
  location            String? // "Bathroom, room 204"
  status              ComplaintStatus   @default(OPEN)
  assignedStaffId     String?           @map("assigned_staff_id") @db.Uuid
  slaDueAt            DateTime          @map("sla_due_at")
  slaBreachNotifiedAt DateTime?         @map("sla_breach_notified_at")
  acknowledgedAt      DateTime?         @map("acknowledged_at")
  resolvedAt          DateTime?         @map("resolved_at")
  resolutionNote      String?           @map("resolution_note")
  closedAt            DateTime?         @map("closed_at")
  reopenCount         Int               @default(0) @map("reopen_count")
  rating              Int?
  feedback            String?
  // When the tenant is free to let someone in (mandatory for new complaints; null only on rows filed before this existed).
  availableFrom       DateTime?         @map("available_from")
  availableTo         DateTime?         @map("available_to")
  allowEntryIfAway    Boolean           @default(false) @map("allow_entry_if_away")
  // The visit staff booked inside that window.
  visitStart          DateTime?         @map("visit_start")
  visitEnd            DateTime?         @map("visit_end")
  visitMissedNotifiedAt DateTime?       @map("visit_missed_notified_at")
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  hostel   Hostel                   @relation(fields: [hostelId], references: [id])
  tenancy  Tenancy                  @relation(fields: [tenancyId], references: [id])
  raisedBy User                     @relation("ComplaintRaisedBy", fields: [raisedById], references: [id])
  assigned User?                    @relation("ComplaintAssignedTo", fields: [assignedStaffId], references: [id])
  media    ComplaintMedia[]
  comments ComplaintComment[]
  history  ComplaintStatusHistory[]

  @@index([hostelId, status, createdAt])
  @@index([raisedById, createdAt])
  @@index([assignedStaffId, status])
  @@index([status, slaDueAt])
  @@map("complaints")
}

model ComplaintMedia {
  id           String      @id @default(uuid(7)) @db.Uuid
  complaintId  String      @map("complaint_id") @db.Uuid
  publicId     String      @unique @map("public_id")
  url          String
  width        Int?
  height       Int?
  uploadedById String      @map("uploaded_by_id") @db.Uuid
  uploaderRole CommentRole @map("uploader_role")
  createdAt    DateTime    @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_media")
}

model ComplaintComment {
  id          String      @id @default(uuid(7)) @db.Uuid
  complaintId String      @map("complaint_id") @db.Uuid
  authorId    String?     @map("author_id") @db.Uuid
  authorRole  CommentRole @map("author_role")
  authorName  String      @map("author_name") // the name at the time, so a thread reads the same later
  body        String
  internal    Boolean     @default(false) // visible to the owner, staff and admin only, never the tenant
  createdAt   DateTime    @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_comments")
}

/// Append-only (a trigger rejects UPDATE and DELETE): who moved a complaint, from where to where, and why.
model ComplaintStatusHistory {
  id          String           @id @default(uuid(7)) @db.Uuid
  complaintId String           @map("complaint_id") @db.Uuid
  fromStatus  ComplaintStatus? @map("from_status")
  toStatus    ComplaintStatus  @map("to_status")
  actorId     String?          @map("actor_id") @db.Uuid
  actorRole   CommentRole      @map("actor_role")
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_status_history")
}

// ───────────────────────── Audit & infra ─────────────────────────

/// Append-only, tamper-evident. `prevHash`/`hash` are computed by a BEFORE INSERT trigger (db_extras),
/// so the chain cannot be forged by application bugs. No FKs on purpose: history must outlive entities.
model AuditLog {
  id         BigInt       @id @default(autoincrement())
  actorId    String?      @map("actor_id") @db.Uuid
  actorRole  String?      @map("actor_role")
  action     String // e.g. auth.login, hostel.update, booking.transition, payment.captured
  entityType String       @map("entity_type")
  entityId   String?      @map("entity_id")
  before     Json?
  after      Json?
  outcome    AuditOutcome @default(SUCCESS)
  requestId  String?      @map("request_id")
  ip         String?
  userAgent  String?      @map("user_agent")
  metadata   Json?
  prevHash   String?      @map("prev_hash")
  hash       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId, id])
  @@index([actorId, id])
  @@index([action, id])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  key            String
  userId         String    @map("user_id") @db.Uuid
  method         String
  path           String
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedAt       DateTime  @default(now()) @map("locked_at")
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime  @map("expires_at")

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
