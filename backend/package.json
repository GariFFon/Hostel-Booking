{
  "name": "hostel-booking-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Hostel Booking API (Next.js, API-only)",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --turbopack -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "worker": "tsx watch --env-file=.env src/worker.ts",
    "worker:start": "tsx --env-file=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "openapi": "tsx --tsconfig tsconfig.json scripts/generate-openapi.ts",
    "check:cloudinary": "tsx --env-file=.env scripts/check-cloudinary.ts",
    "check:geocode": "tsx --env-file=.env scripts/check-geocode.ts",
    "dev:all": "concurrently -k -n api,worker -c blue,magenta \"pnpm dev\" \"pnpm worker\""
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.2",
    "cloudinary": "^2.11.0",
    "google-auth-library": "^11.3.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.16",
    "next": "16",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19",
    "react-dom": "19",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "7",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "^5.1.0"
  }
}
