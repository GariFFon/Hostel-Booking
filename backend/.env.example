# ---- App ----
NODE_ENV=development
APP_ENV=local                      # local | test | staging | production
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database (dedicated Homebrew PG16 on 5433; see docs/runbook.md) ----
DATABASE_URL=postgresql://hostel:hostel_dev_pw@127.0.0.1:5433/hostel_dev?schema=public

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Auth ----
# Generate your own:  openssl rand -base64 48   (never reuse a value from a template or another environment)
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_IDS=                 # comma-separated: web,android,ios OAuth client IDs

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=hostel-booking

# ---- Mail (Mailpit locally: SMTP 1025, UI 8025) ----
MAIL_DRIVER=smtp                   # smtp | resend | log
MAIL_FROM="Hostel Booking <no-reply@hostel.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
RESEND_API_KEY=

# ---- Payments (demo gateway) ----
PAYMENT_PROVIDER=demo
# Generate your own:  openssl rand -hex 32
DEMO_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32
ALLOW_DEMO_PAYMENTS=false           # demo gateway is refused when APP_ENV=production unless true
DEMO_WEBHOOK_DELAY_MS=1500

# ---- Business defaults ----
GST_LOW_BPS=500                    # 5% when the per-night room tariff is <= threshold
GST_HIGH_BPS=1800                  # 18% above the threshold
GST_THRESHOLD_PAISE=750000         # Rs 7,500

# ---- Geocoding (OpenStreetMap Nominatim; set a real contact in the User-Agent per their policy) ----
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=HostelBookingApp/1.0 (contact: set-a-real-contact@your-domain.example)
GEOCODER_COUNTRY_CODES=in
PLATFORM_COMMISSION_BPS=1000       # 10.00%
BOOKING_HOLD_MINUTES=15            # unpaid instant-book hold
APPROVAL_WINDOW_HOURS=24           # request-to-book: owner response deadline
APPROVAL_PAYMENT_WINDOW_MINUTES=180 # then the guest's time to pay
MAX_OPEN_BOOKINGS_PER_USER=3       # unpaid holds per guest (stops inventory hoarding)
QUEUE_MODE=bullmq                  # bullmq | inline (run jobs in-process). Needs `pnpm worker` when bullmq.
